{
  "name": "truehalo",
  "private": true,
  "version": "0.4.1",
  "type": "module",
  "description": "Native, privacy-first AI screen overlay for documents, code, and translations.",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Neksand/TrueHalo.git"
  },
  "homepage": "https://github.com/Neksand/TrueHalo#readme",
  "bugs": {
    "url": "https://github.com/Neksand/TrueHalo/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "fmt:check": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "preview": "vite preview",
    "tauri": "tauri",
    "sign:setup": "bash scripts/setup-signing.sh",
    "app:build": "bash scripts/build.sh",
    "app:install": "bash scripts/build.sh --install"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.2.0",
    "@tauri-apps/plugin-global-shortcut": "^2.2.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.2.0",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.2.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.5"
  }
}
